---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---

<Base title="Thank you" noindex>
  <section class="resume-section" id="thanks">
    <div class="section-inner">
      <h1 class="mb-0">Thank <span class="text-primary">You</span></h1>
      <div class="subheading mb-5">Message received</div>
      <p class="mb-3">Thanks for getting in touch — I'll reply as soon as I can.</p>
      <p class="mb-5">
        <a href="/">Back to {SITE.name}</a>
      </p>
    </div>
  </section>
</Base>
