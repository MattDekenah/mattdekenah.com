---
import "@fontsource-variable/open-sans";
import "@fontsource/saira-extra-condensed/500.css";
import "@fontsource/saira-extra-condensed/700.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { SITE } from "../config";
import { personSchema } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The home page passes a richer Person object built from the CV content. */
  schema?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  schema = personSchema(),
} = Astro.props;

const structuredData = JSON.stringify(schema);

const pageTitle = title
  ? `${title} // ${SITE.name}`
  : `${SITE.name} // ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#006600" />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="profile:first_name" content={SITE.firstName} />
    <meta property="profile:last_name" content={SITE.lastName} />
    <meta property="profile:username" content={SITE.username} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={`${SITE.url}${SITE.ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={`${SITE.url}${SITE.ogImage}`} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
